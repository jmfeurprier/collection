{
    "name": "jmf/collection",
    "description" : "Eases common operations with collections (arrays, iterables, etc).",
    "license": "mit",
    "type": "library",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "overtrue/phplint": "^9.7",
        "phpstan/phpstan": "^2.1.33",
        "phpstan/phpstan-strict-rules": "^2.0.7",
        "phpunit/phpunit": "^12.5.4",
        "rector/rector": "^2.3.0",
        "squizlabs/php_codesniffer": "^4.0.1"
    },
    "config": {
        "audit": {
            "abandoned": "report"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Jmf\\Collection\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jmf\\Collection\\": "tests/src"
        }
    }
}
